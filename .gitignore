# ==========================================
# Root .gitignore for AI-Engineer Repository
# ==========================================

# 1. Virtual Environments
.venv/
*/.venv/
*/*/.venv/
venv/
*/venv/
env/
*/env/
ENV/

# 2. Python Cache & Build Artifacts
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 3. Node & Frontend
node_modules/
*/node_modules/
*/*/node_modules/
*/*/*/node_modules/
dist/
*/dist/
*/*/dist/
.vite/
*/.vite/
*/*/.vite/

# 4. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Jupyter Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*/*/.ipynb_checkpoints/

# 6. Environment & Secrets
.env
.env.*
!.env.example
*.local

# 7. OS & Editors
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

